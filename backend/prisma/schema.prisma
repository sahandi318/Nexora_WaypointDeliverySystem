// ============================================================
// Nexora Waypoint Delivery System
// Database Schema
// ============================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// USER ROLES
// ============================================================

enum UserRole {
  ADMIN
  STORE_MANAGER
  DISPATCHER
  LOADER
  DRIVER
}

// ============================================================
// STORE ORDER STATUS
// ============================================================

enum StoreOrderStatus {
  SUBMITTED
  DEFERRED
  CONFIRMED
  CANCELLED
}

// ============================================================
// STORE ORDER DISPATCHER DECISION
// ============================================================

enum StoreOrderDecisionType {
  CONFIRMED
  DEFERRED
}

// ============================================================
// STORE ORDER CUTOFF DECISION
// ============================================================

enum StoreOrderCutoffDecision {
  ON_TIME
  AFTER_CUTOFF
}

// ============================================================
// STORE ORDER / PRODUCT HANDLING TYPE
// ============================================================

enum StoreOrderType {
  AMBIENT_DRY
  CHILLED
}

// ============================================================
// DELIVERY ALLOCATION STATUS
// ============================================================

enum DeliveryAllocationStatus {
  ALLOCATED
  PUBLISHED
  CANCELLED
}

// ============================================================
// DEPOT
// ============================================================

model Depot {
  id Int @id @default(autoincrement())

  code     String  @unique @db.VarChar(30)
  name     String  @unique @db.VarChar(120)
  district String? @db.VarChar(100)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets       Outlet[]
  users         User[]
  liveTrips     LiveTrip[]
  vehicles      Vehicle[]
  deliveryPlans DeliveryPlan[]

  @@map("depots")
}

// ============================================================
// OUTLET
// ============================================================

model Outlet {
  id Int @id @default(autoincrement())

  outletCode String @unique @db.VarChar(30)

  brand    String @db.VarChar(120)
  district String @db.VarChar(100)

  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id])

  dockType          String? @db.VarChar(100)
  parkingConstraint String? @db.Text
  mallWindow        String? @db.VarChar(100)

  windowOpenTime  String? @db.VarChar(20)
  windowCloseTime String? @db.VarChar(20)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  storeOrders StoreOrder[]

  @@index([depotId])
  @@index([district])
  @@map("outlets")
}

// ============================================================
// USER
// ============================================================

model User {
  id Int @id @default(autoincrement())

  userId String @unique @db.VarChar(50)

  fullName String @db.VarChar(150)

  email String? @unique @db.VarChar(180)
  phone String? @db.VarChar(30)

  // Small processed profile photo stored as a data URL.
  // Used by the administrator profile and compact admin avatar.
  profilePhotoData String? @db.LongText

  passwordHash String @db.VarChar(255)

  role UserRole

  outletId Int?
  outlet   Outlet? @relation(fields: [outletId], references: [id])

  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id])

  isActive Boolean @default(true)

  mustChangePassword Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetOtps     PasswordResetOtp[]
  liveTripsAsDriver     LiveTrip[]            @relation("LiveTripDriver")
  createdStoreOrders    StoreOrder[]          @relation("StoreOrderCreatedBy")
  storeOrderDecisions   StoreOrderDecision[]  @relation("StoreOrderDecisionBy")
  dispatcherDeliveryPlans DeliveryPlan[] @relation("DispatcherDeliveryPlans")

  @@index([role])
  @@index([outletId])
  @@index([depotId])
  @@map("users")
}

// ============================================================
// PASSWORD RESET OTP
// ============================================================

model PasswordResetOtp {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // HMAC-SHA256 hash of the real six-digit OTP.
  otpHash String @db.VarChar(64)

  // OTP cannot be verified after this time.
  expiresAt DateTime

  // Number of failed verification attempts.
  attempts Int @default(0)

  // Set once the OTP has successfully been verified
  // or otherwise invalidated.
  usedAt DateTime?

  // Set after a successful password reset.
  // Prevents reset authorization from being reused.
  resetCompletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_otps")
}

// ============================================================
// TRANSLATION CACHE
// ============================================================

model TranslationCache {
  id Int @id @default(autoincrement())

  // SHA-256 key generated from source language,
  // target language and source text.
  cacheKey String @unique @db.VarChar(64)

  sourceLanguage String @db.VarChar(10)
  targetLanguage String @db.VarChar(10)

  sourceText     String @db.Text
  translatedText String @db.Text

  // Examples: google, manual
  provider String @db.VarChar(40)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceLanguage, targetLanguage])
  @@index([targetLanguage])
  @@map("translation_cache")
}

// ============================================================
// LIVE DELIVERY MONITORING
// ============================================================

model LiveTrip {
  id Int @id @default(autoincrement())

  tripCode     String   @unique @db.VarChar(50)
  deliveryDate DateTime @db.Date

  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id], onDelete: SetNull)

  vehicleCode String  @db.VarChar(50)
  vehicleType String? @db.VarChar(120)
  temperature String? @db.VarChar(120)

  driverUserId Int?
  driver       User? @relation("LiveTripDriver", fields: [driverUserId], references: [id], onDelete: SetNull)

  driverName String @db.VarChar(150)

  status            String @default("PLANNED") @db.VarChar(40)
  progressCompleted Int    @default(0)
  progressTotal     Int    @default(0)

  nextDestination String? @db.VarChar(120)
  eta             String? @db.VarChar(40)

  isDriverOnline   Boolean   @default(true)
  currentLat       Float?
  currentLng       Float?
  lastSynchronized DateTime?

  latestDriverUpdate   String?   @db.Text
  latestDriverUpdateAt DateTime?
  routeUpdatedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stops             LiveTripStop[]
  events            LiveTripEvent[]
  loadingExceptions LoadingException[]

  @@index([deliveryDate])
  @@index([depotId, deliveryDate])
  @@index([driverUserId])
  @@index([status])
  @@map("live_trips")
}

// ============================================================
// LIVE DELIVERY STOPS
// ============================================================

model LiveTripStop {
  id Int @id @default(autoincrement())

  stopCode String @unique @db.VarChar(50)

  liveTripId Int
  liveTrip   LiveTrip @relation(fields: [liveTripId], references: [id], onDelete: Cascade)

  sequence Int

  outletCode String  @db.VarChar(50)
  outletName String? @db.VarChar(150)
  district   String? @db.VarChar(100)

  latitude  Float?
  longitude Float?

  plannedEta    String? @db.VarChar(40)
  actualArrival String? @db.VarChar(40)

  status  String  @default("PENDING") @db.VarChar(40)
  outcome String? @db.VarChar(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveryAllocations DeliveryAllocation[]

  @@index([liveTripId, sequence])
  @@index([outletCode])
  @@map("live_trip_stops")
}

// ============================================================
// LIVE DELIVERY EVENTS
// ============================================================

model LiveTripEvent {
  id Int @id @default(autoincrement())

  liveTripId Int
  liveTrip   LiveTrip @relation(fields: [liveTripId], references: [id], onDelete: Cascade)

  type    String @db.VarChar(60)
  message String @db.Text
  payload Json?

  createdAt DateTime @default(now())

  @@index([liveTripId, createdAt])
  @@map("live_trip_events")
}

// ============================================================
// PRODUCT CATALOG
// ============================================================

model Product {
  id Int @id @default(autoincrement())

  sku  String @unique @db.VarChar(40)
  name String @db.VarChar(160)

  manufacturerBrand String         @default("Nexora Demo") @map("manufacturer_brand") @db.VarChar(120)
  productType       String         @default("General") @map("product_type") @db.VarChar(100)
  handlingType      StoreOrderType @default(AMBIENT_DRY) @map("handling_type")

  category     String? @db.VarChar(100)
  unitLabel    String  @default("unit") @map("unit_label") @db.VarChar(40)
  unitWeightKg Decimal @default(0.100) @map("unit_weight_kg") @db.Decimal(10, 3)
  unitVolumeM3 Decimal @default(0.000100) @map("unit_volume_m3") @db.Decimal(12, 6)

  imageData     Bytes?  @map("image_data") @db.LongBlob
  imageMimeType String? @map("image_mime_type") @db.VarChar(100)

  // Makes demo/application-owned catalog data clearly
  // distinguishable from organizer-provided operational data.
  source String @default("APPLICATION_DEMO") @db.VarChar(40)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderItems       StoreOrderItem[]
  brandAssignments ProductBrandAssignment[]

  @@index([category])
  @@index([handlingType])
  @@index([manufacturerBrand])
  @@index([productType])
  @@index([isActive])
  @@map("products")
}

// ============================================================
// PRODUCT BRAND ASSIGNMENT
// ============================================================

model ProductBrandAssignment {
  id Int @id @default(autoincrement())

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  brand String @db.VarChar(120)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, brand])
  @@index([brand, isActive])
  @@map("product_brand_assignments")
}

// ============================================================
// STORE ORDER
// ============================================================

model StoreOrder {
  id Int @id @default(autoincrement())

  orderCode String @unique @map("order_code") @db.VarChar(40)

  outletId Int    @map("outlet_id")
  outlet   Outlet @relation(fields: [outletId], references: [id])

  createdByUserId Int  @map("created_by_user_id")
  createdByUser   User @relation("StoreOrderCreatedBy", fields: [createdByUserId], references: [id])

  status         StoreOrderStatus         @default(SUBMITTED)
  orderType      StoreOrderType           @default(AMBIENT_DRY) @map("order_type")
  cutoffDecision StoreOrderCutoffDecision @map("cutoff_decision")

  submittedAt DateTime @default(now()) @map("submitted_at")

  requestedDispatchDate DateTime @map("requested_dispatch_date") @db.Date
  effectiveDispatchDate DateTime @map("effective_dispatch_date") @db.Date

  deferredReason String? @map("deferred_reason") @db.Text

  storeManagerNote String? @map("store_manager_note") @db.VarChar(500)

  totalUnits        Int     @map("total_units")
  estimatedWeightKg Decimal @default(0.000) @map("estimated_weight_kg") @db.Decimal(12, 3)
  estimatedVolumeM3 Decimal @default(0.000000) @map("estimated_volume_m3") @db.Decimal(14, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items               StoreOrderItem[]
  deliveryAllocations DeliveryAllocation[]
  dispatcherDecisions StoreOrderDecision[]
  tripAllocations   TripOrderAllocation[]
  loadingExceptions LoadingException[]

  @@index([outletId, submittedAt])
  @@index([outletId, status])
  @@index([outletId, orderType])
  @@index([createdByUserId])
  @@index([effectiveDispatchDate])
  @@map("store_orders")
}


// ============================================================
// STORE ORDER DISPATCHER DECISION HISTORY
// ============================================================

/// Immutable audit trail for Dispatcher decisions on Store Manager orders.
/// Current state stays on StoreOrder.status; this table records who changed
/// that state and why, without duplicating the order itself.
model StoreOrderDecision {
  id Int @id @default(autoincrement())

  storeOrderId Int        @map("store_order_id")
  storeOrder   StoreOrder @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)

  decidedByUserId Int?  @map("decided_by_user_id")
  decidedByUser   User? @relation("StoreOrderDecisionBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  decision        StoreOrderDecisionType
  previousStatus  StoreOrderStatus       @map("previous_status")
  resultingStatus StoreOrderStatus       @map("resulting_status")

  reason String? @db.VarChar(500)

  effectiveDispatchDate DateTime @map("effective_dispatch_date") @db.Date

  decidedAt DateTime @default(now()) @map("decided_at")

  @@index([storeOrderId, decidedAt])
  @@index([decidedByUserId])
  @@index([decision, decidedAt])
  @@map("store_order_decisions")
}

// ============================================================
// STORE ORDER ITEM
// ============================================================

model StoreOrderItem {
  id Int @id @default(autoincrement())

  orderId Int        @map("order_id")
  order   StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([orderId, productId])
  @@index([productId])
  @@map("store_order_items")
}

// ============================================================
// DELIVERY ALLOCATION BRIDGE
// ============================================================

/// Connects a confirmed Store Manager order to the exact live trip stop
/// that will deliver it. This bridge keeps the business order lifecycle
/// separate from transport execution while still allowing multiple store
/// orders to share the same outlet stop.
model DeliveryAllocation {
  id Int @id @default(autoincrement())

  storeOrderId Int        @map("store_order_id")
  storeOrder   StoreOrder @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)

  liveTripStopId Int          @map("live_trip_stop_id")
  liveTripStop   LiveTripStop @relation(fields: [liveTripStopId], references: [id], onDelete: Cascade)

  status DeliveryAllocationStatus @default(ALLOCATED)

  // Snapshot of the StoreOrder total units at allocation time.
  // The dispatcher does not provide this value from the browser.
  allocatedUnits Int @map("allocated_units")

  allocatedAt DateTime  @default(now()) @map("allocated_at")
  publishedAt DateTime? @map("published_at")
  cancelledAt DateTime? @map("cancelled_at")

  cancellationReason String? @map("cancellation_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeOrderId, liveTripStopId])
  @@index([storeOrderId, status])
  @@index([liveTripStopId, status])
  @@map("delivery_allocations")
}

// ============================================================
// VEHICLE
// ============================================================

model Vehicle {
  id Int @id @default(autoincrement())

  vehicleCode String @unique @map("vehicle_code") @db.VarChar(50)

  vehicleType String @map("vehicle_type") @db.VarChar(120)

  depotId Int
  depot   Depot @relation(fields: [depotId], references: [id])

  capacityWeightKg Decimal @map("capacity_weight_kg") @db.Decimal(12, 3)
  capacityVolumeM3 Decimal @map("capacity_volume_m3") @db.Decimal(14, 6)

  refrigerated Boolean @default(false)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plannedTrips PlannedTrip[]

  @@index([depotId])
  @@index([isActive])
  @@map("vehicles")
}

// ============================================================
// DELIVERY PLAN
// ============================================================

model DeliveryPlan {
  id Int @id @default(autoincrement())

  deliveryDate DateTime @map("delivery_date") @db.Date

  depotId Int
  depot   Depot @relation(fields: [depotId], references: [id])

  status String @default("DRAFT") @db.VarChar(40)

  createdByUserId Int?  @map("created_by_user_id")
  createdByUser   User? @relation("DispatcherDeliveryPlans", fields: [createdByUserId], references: [id])

  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trips PlannedTrip[]

  @@unique([deliveryDate, depotId])
  @@index([status])
  @@map("delivery_plans")
}

// ============================================================
// PLANNED TRIP
// ============================================================

model PlannedTrip {
  id Int @id @default(autoincrement())

  tripCode String @unique @map("trip_code") @db.VarChar(50)

  planId Int
  plan   DeliveryPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  tripNumber Int @map("trip_number")

  plannedDeparture String? @map("planned_departure") @db.VarChar(20)

  status String @default("PLANNED") @db.VarChar(40)

  totalWeightKg Decimal @default(0.000) @map("total_weight_kg") @db.Decimal(12, 3)
  totalVolumeM3 Decimal @default(0.000000) @map("total_volume_m3") @db.Decimal(14, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  allocations TripOrderAllocation[]

  @@unique([planId, vehicleId, tripNumber])
  @@index([planId])
  @@index([vehicleId])
  @@map("planned_trips")
}

// ============================================================
// TRIP ORDER ALLOCATION
// ============================================================

model TripOrderAllocation {
  id Int @id @default(autoincrement())

  plannedTripId Int         @map("planned_trip_id")
  plannedTrip   PlannedTrip @relation(fields: [plannedTripId], references: [id], onDelete: Cascade)

  storeOrderId Int        @map("store_order_id")
  storeOrder   StoreOrder @relation(fields: [storeOrderId], references: [id])

  stopSequence Int? @map("stop_sequence")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([plannedTripId, storeOrderId])
  @@index([storeOrderId])
  @@map("trip_order_allocations")
}

// ============================================================
// LOADING EXCEPTION
// ============================================================

model LoadingException {
  id Int @id @default(autoincrement())

  exceptionCode String @unique @map("exception_code") @db.VarChar(50)

  liveTripId Int?      @map("live_trip_id")
  liveTrip   LiveTrip? @relation(fields: [liveTripId], references: [id], onDelete: SetNull)

  storeOrderId Int?        @map("store_order_id")
  storeOrder   StoreOrder? @relation(fields: [storeOrderId], references: [id], onDelete: SetNull)

  exceptionType String @map("exception_type") @db.VarChar(60)

  itemName String? @map("item_name") @db.VarChar(160)

  expectedQuantity  Int? @map("expected_quantity")
  availableQuantity Int? @map("available_quantity")

  loaderName String? @map("loader_name") @db.VarChar(150)

  loaderNote String? @map("loader_note") @db.Text

  status String @default("OPEN") @db.VarChar(40)

  resolutionAction String?   @map("resolution_action") @db.VarChar(100)
  resolutionNote   String?   @map("resolution_note") @db.Text
  resolvedAt       DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([liveTripId])
  @@index([storeOrderId])
  @@index([status])
  @@map("loading_exceptions")
}
