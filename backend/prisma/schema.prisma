// ============================================================
// Nexora Waypoint Delivery System
// Database Schema
// ============================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// USER ROLES
// ============================================================

enum UserRole {
  ADMIN
  STORE_MANAGER
  DISPATCHER
  LOADER
  DRIVER
}

// ============================================================
// STORE ORDER STATUS
// ============================================================

enum StoreOrderStatus {
  SUBMITTED
  DEFERRED
  CONFIRMED
  CANCELLED
}

// ============================================================
// STORE ORDER CUTOFF DECISION
// ============================================================

enum StoreOrderCutoffDecision {
  ON_TIME
  AFTER_CUTOFF
}

// ============================================================
// STORE ORDER / PRODUCT HANDLING TYPE
// ============================================================

enum StoreOrderType {
  AMBIENT_DRY
  CHILLED
}

// ============================================================
// DEPOT
// ============================================================

model Depot {
  id Int @id @default(autoincrement())

  code     String  @unique @db.VarChar(30)
  name     String  @unique @db.VarChar(120)
  district String? @db.VarChar(100)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets Outlet[]
  users   User[]

  @@map("depots")
}

// ============================================================
// OUTLET
// ============================================================

model Outlet {
  id Int @id @default(autoincrement())

  outletCode String @unique @db.VarChar(30)

  brand    String @db.VarChar(120)
  district String @db.VarChar(100)

  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id])

  dockType          String? @db.VarChar(100)
  parkingConstraint String? @db.Text
  mallWindow        String? @db.VarChar(100)

  windowOpenTime  String? @db.VarChar(20)
  windowCloseTime String? @db.VarChar(20)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  storeOrders StoreOrder[]

  @@index([depotId])
  @@index([district])
  @@map("outlets")
}

// ============================================================
// USER
// ============================================================

model User {
  id Int @id @default(autoincrement())

  userId String @unique @db.VarChar(50)

  fullName String @db.VarChar(150)

  email String? @unique @db.VarChar(180)
  phone String? @db.VarChar(30)

  // Small processed profile photo stored as a data URL.
  // Used by the administrator profile and compact admin avatar.
  profilePhotoData String? @db.LongText

  passwordHash String @db.VarChar(255)

  role UserRole

  outletId Int?
  outlet   Outlet? @relation(fields: [outletId], references: [id])

  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id])

  isActive Boolean @default(true)

  mustChangePassword Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetOtps PasswordResetOtp[]

  createdStoreOrders StoreOrder[] @relation("StoreOrderCreatedBy")

  @@index([role])
  @@index([outletId])
  @@index([depotId])
  @@map("users")
}

// ============================================================
// PASSWORD RESET OTP
// ============================================================

model PasswordResetOtp {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // HMAC-SHA256 hash of the real six-digit OTP.
  otpHash String @db.VarChar(64)

  // OTP cannot be verified after this time.
  expiresAt DateTime

  // Number of failed verification attempts.
  attempts Int @default(0)

  // Set once the OTP has successfully been verified
  // or otherwise invalidated.
  usedAt DateTime?

  // Set after a successful password reset.
  // Prevents reset authorization from being reused.
  resetCompletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_otps")
}

// ============================================================
// TRANSLATION CACHE
// ============================================================

model TranslationCache {
  id Int @id @default(autoincrement())

  // SHA-256 key generated from:
  //
  // source language
  // target language
  // source text
  //
  // The same translation can therefore be reused without
  // calling the external translation provider again.
  cacheKey String @unique @db.VarChar(64)

  sourceLanguage String @db.VarChar(10)
  targetLanguage String @db.VarChar(10)

  sourceText     String @db.Text
  translatedText String @db.Text

  // Examples:
  // google
  // manual
  provider String @db.VarChar(40)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceLanguage, targetLanguage])
  @@index([targetLanguage])
  @@map("translation_cache")
}

// ============================================================
// PRODUCT CATALOG
// ============================================================

model Product {
  id Int @id @default(autoincrement())

  sku  String @unique @db.VarChar(40)
  name String @db.VarChar(160)

  manufacturerBrand String         @default("Nexora Demo") @map("manufacturer_brand") @db.VarChar(120)
  productType       String         @default("General") @map("product_type") @db.VarChar(100)
  handlingType      StoreOrderType @default(AMBIENT_DRY) @map("handling_type")

  category  String? @db.VarChar(100)
  unitLabel    String  @default("unit") @map("unit_label") @db.VarChar(40)
  unitWeightKg Decimal @default(0.100) @map("unit_weight_kg") @db.Decimal(10, 3)
  unitVolumeM3 Decimal @default(0.000100) @map("unit_volume_m3") @db.Decimal(12, 6)

  imageData     Bytes?  @map("image_data") @db.LongBlob
  imageMimeType String? @map("image_mime_type") @db.VarChar(100)

  // Makes demo/application-owned catalog data clearly
  // distinguishable from organizer-provided operational data.
  source String @default("APPLICATION_DEMO") @db.VarChar(40)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderItems       StoreOrderItem[]
  brandAssignments ProductBrandAssignment[]

  @@index([category])
  @@index([handlingType])
  @@index([manufacturerBrand])
  @@index([productType])
  @@index([isActive])
  @@map("products")
}

// ============================================================
// PRODUCT BRAND ASSIGNMENT
// ============================================================

model ProductBrandAssignment {
  id Int @id @default(autoincrement())

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  brand String @db.VarChar(120)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, brand])
  @@index([brand, isActive])
  @@map("product_brand_assignments")
}

// ============================================================
// STORE ORDER
// ============================================================

model StoreOrder {
  id Int @id @default(autoincrement())

  orderCode String @unique @map("order_code") @db.VarChar(40)

  outletId Int @map("outlet_id")
  outlet   Outlet @relation(fields: [outletId], references: [id])

  createdByUserId Int @map("created_by_user_id")
  createdByUser   User @relation("StoreOrderCreatedBy", fields: [createdByUserId], references: [id])

  status         StoreOrderStatus         @default(SUBMITTED)
  orderType      StoreOrderType           @default(AMBIENT_DRY) @map("order_type")
  cutoffDecision StoreOrderCutoffDecision @map("cutoff_decision")

  // Time at which the backend accepted the order submission.
  submittedAt DateTime @default(now()) @map("submitted_at")

  // The Store Manager's normal next-day request.
  requestedDispatchDate DateTime @map("requested_dispatch_date") @db.Date

  // Actual processing date after applying the 4 PM cutoff.
  effectiveDispatchDate DateTime @map("effective_dispatch_date") @db.Date

  // Stored only when the request is moved to the following run.
  deferredReason String? @map("deferred_reason") @db.Text

  // Optional instruction from the Store Manager for downstream
  // dispatcher planning. This note belongs to the order itself.
  storeManagerNote String? @map("store_manager_note") @db.VarChar(500)

  // Convenience totals calculated only by the backend from
  // database product metadata at submission time.
  totalUnits          Int     @map("total_units")
  estimatedWeightKg   Decimal @default(0.000) @map("estimated_weight_kg") @db.Decimal(12, 3)
  estimatedVolumeM3   Decimal @default(0.000000) @map("estimated_volume_m3") @db.Decimal(14, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items StoreOrderItem[]

  @@index([outletId, submittedAt])
  @@index([outletId, status])
  @@index([outletId, orderType])
  @@index([createdByUserId])
  @@index([effectiveDispatchDate])
  @@map("store_orders")
}

// ============================================================
// STORE ORDER ITEM
// ============================================================

model StoreOrderItem {
  id Int @id @default(autoincrement())

  orderId Int @map("order_id")
  order   StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([orderId, productId])
  @@index([productId])
  @@map("store_order_items")
}
