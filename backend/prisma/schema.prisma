// ============================================================
// Nexora Waypoint Delivery System
// Core Database Schema
// ============================================================
//
// This first migration establishes the shared authentication,
// depot and outlet foundation.
//
// Store Manager orders, products, deliveries, receipts,
// issues and notifications will be added in later migrations.
// ============================================================

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}


// ============================================================
// USER ROLES
// ============================================================

enum UserRole {
  ADMIN
  STORE_MANAGER
  DISPATCHER
  LOADER
  DRIVER
}


// ============================================================
// DEPOT
// ============================================================
//
// Represents an operational distribution depot.
// ============================================================

model Depot {
  id Int @id @default(autoincrement())

  code     String  @unique @db.VarChar(30)
  name     String  @unique @db.VarChar(120)
  district String? @db.VarChar(100)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  outlets Outlet[]
  users   User[]

  @@map("depots")
}


// ============================================================
// OUTLET
// ============================================================
//
// Outlet records will later be populated using the official
// competition organizer dataset.
// ============================================================

model Outlet {
  id Int @id @default(autoincrement())

  // Organizer-provided outlet identifier.
  outletCode String @unique @db.VarChar(30)

  brand    String @db.VarChar(120)
  district String @db.VarChar(100)

  // Assigned distribution depot.
  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id])

  // Organizer-provided operational constraints.
  dockType String? @db.VarChar(100)

  parkingConstraint String? @db.Text

  mallWindow String? @db.VarChar(100)

  windowOpenTime  String? @db.VarChar(20)
  windowCloseTime String? @db.VarChar(20)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Store Managers assigned to this outlet.
  users User[]

  @@index([depotId])
  @@index([district])

  @@map("outlets")
}


// ============================================================
// USER
// ============================================================
//
// One authentication table is shared by all application roles.
//
// Login requires only:
//   - User ID
//   - Password
//
// The user's role, outlet and depot are determined from the
// database after successful authentication.
// ============================================================

model User {
  id Int @id @default(autoincrement())

  // Human-readable login identifier, e.g. SM001.
  userId String @unique @db.VarChar(50)

  fullName String @db.VarChar(150)

  email String? @unique @db.VarChar(180)
  phone String? @db.VarChar(30)

  // Only a bcrypt hash is stored. Never store plain passwords.
  passwordHash String @db.VarChar(255)

  role UserRole

  // Store Managers can be linked to one outlet.
  outletId Int?
  outlet   Outlet? @relation(fields: [outletId], references: [id])

  // Depot-oriented roles can be linked to a depot.
  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id])

  isActive Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([outletId])
  @@index([depotId])

  @@map("users")
}