// ============================================================
// Nexora Waypoint Delivery System
// Database Schema
// ============================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// USER ROLES
// ============================================================

enum UserRole {
  ADMIN
  STORE_MANAGER
  DISPATCHER
  LOADER
  DRIVER
}

// ============================================================
// DEPOT
// ============================================================

model Depot {
  id Int @id @default(autoincrement())

  code     String  @unique @db.VarChar(30)
  name     String  @unique @db.VarChar(120)
  district String? @db.VarChar(100)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets Outlet[]
  users   User[]

  @@map("depots")
}

// ============================================================
// OUTLET
// ============================================================

model Outlet {
  id Int @id @default(autoincrement())

  outletCode String @unique @db.VarChar(30)

  brand    String @db.VarChar(120)
  district String @db.VarChar(100)

  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id])

  dockType          String? @db.VarChar(100)
  parkingConstraint String? @db.Text
  mallWindow        String? @db.VarChar(100)

  windowOpenTime  String? @db.VarChar(20)
  windowCloseTime String? @db.VarChar(20)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([depotId])
  @@index([district])
  @@map("outlets")
}

// ============================================================
// USER
// ============================================================

model User {
  id Int @id @default(autoincrement())

  userId String @unique @db.VarChar(50)

  fullName String @db.VarChar(150)

  email String? @unique @db.VarChar(180)
  phone String? @db.VarChar(30)

  passwordHash String @db.VarChar(255)

  role UserRole

  outletId Int?
  outlet   Outlet? @relation(fields: [outletId], references: [id])

  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id])

  isActive Boolean @default(true)

  mustChangePassword Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetOtps PasswordResetOtp[]

  @@index([role])
  @@index([outletId])
  @@index([depotId])
  @@map("users")
}

// ============================================================
// PASSWORD RESET OTP
// ============================================================
//
// The real six-digit OTP is never stored.
// Only a cryptographic HMAC hash is stored.
//
// Stage 5.5D will use:
// - expiration
// - attempt limits
// - one-time use protection
//
// ============================================================

model PasswordResetOtp {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  otpHash String @db.VarChar(64)

  expiresAt DateTime

  attempts Int @default(0)

  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_otps")
}
