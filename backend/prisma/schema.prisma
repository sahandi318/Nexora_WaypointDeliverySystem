// ============================================================
// Nexora Waypoint Delivery System
// Database Schema
// ============================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// USER ROLES
// ============================================================

enum UserRole {
  ADMIN
  STORE_MANAGER
  DISPATCHER
  LOADER
  DRIVER
}

// ============================================================
// DEPOT
// ============================================================

model Depot {
  id Int @id @default(autoincrement())

  code     String  @unique @db.VarChar(30)
  name     String  @unique @db.VarChar(120)
  district String? @db.VarChar(100)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets Outlet[]
  users   User[]
  liveTrips LiveTrip[]

  @@map("depots")
}

// ============================================================
// OUTLET
// ============================================================

model Outlet {
  id Int @id @default(autoincrement())

  outletCode String @unique @db.VarChar(30)

  brand    String @db.VarChar(120)
  district String @db.VarChar(100)

  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id])

  dockType          String? @db.VarChar(100)
  parkingConstraint String? @db.Text
  mallWindow        String? @db.VarChar(100)

  windowOpenTime  String? @db.VarChar(20)
  windowCloseTime String? @db.VarChar(20)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([depotId])
  @@index([district])
  @@map("outlets")
}

// ============================================================
// USER
// ============================================================

model User {
  id Int @id @default(autoincrement())

  userId String @unique @db.VarChar(50)

  fullName String @db.VarChar(150)

  email String? @unique @db.VarChar(180)
  phone String? @db.VarChar(30)

  // Small processed profile photo stored as a data URL.
  // Used by the administrator profile and compact admin avatar.
  profilePhotoData String? @db.LongText

  passwordHash String @db.VarChar(255)

  role UserRole

  outletId Int?
  outlet   Outlet? @relation(fields: [outletId], references: [id])

  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id])

  isActive Boolean @default(true)

  mustChangePassword Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetOtps PasswordResetOtp[]
  liveTripsAsDriver LiveTrip[] @relation("LiveTripDriver")

  @@index([role])
  @@index([outletId])
  @@index([depotId])
  @@map("users")
}

// ============================================================
// PASSWORD RESET OTP
// ============================================================

model PasswordResetOtp {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // HMAC-SHA256 hash of the real six-digit OTP.
  otpHash String @db.VarChar(64)

  // OTP cannot be verified after this time.
  expiresAt DateTime

  // Number of failed verification attempts.
  attempts Int @default(0)

  // Set once the OTP has successfully been verified
  // or otherwise invalidated.
  usedAt DateTime?

  // Set after Stage 5.5E successfully changes the password.
  // This prevents the reset authorization from being reused.
  resetCompletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_otps")
}


// ============================================================
// LIVE DELIVERY MONITORING
// ============================================================

model LiveTrip {
  id Int @id @default(autoincrement())

  tripCode String @unique @db.VarChar(50)
  deliveryDate DateTime @db.Date

  depotId Int?
  depot Depot? @relation(fields: [depotId], references: [id], onDelete: SetNull)

  vehicleCode String @db.VarChar(50)
  vehicleType String? @db.VarChar(120)
  temperature String? @db.VarChar(120)

  driverUserId Int?
  driver User? @relation("LiveTripDriver", fields: [driverUserId], references: [id], onDelete: SetNull)
  driverName String @db.VarChar(150)

  status String @default("PLANNED") @db.VarChar(40)
  progressCompleted Int @default(0)
  progressTotal Int @default(0)

  nextDestination String? @db.VarChar(120)
  eta String? @db.VarChar(40)

  isDriverOnline Boolean @default(true)
  currentLat Float?
  currentLng Float?
  lastSynchronized DateTime?

  latestDriverUpdate String? @db.Text
  latestDriverUpdateAt DateTime?
  routeUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stops LiveTripStop[]
  events LiveTripEvent[]

  @@index([deliveryDate])
  @@index([depotId, deliveryDate])
  @@index([driverUserId])
  @@index([status])
  @@map("live_trips")
}

model LiveTripStop {
  id Int @id @default(autoincrement())

  stopCode String @unique @db.VarChar(50)

  liveTripId Int
  liveTrip LiveTrip @relation(fields: [liveTripId], references: [id], onDelete: Cascade)

  sequence Int
  outletCode String @db.VarChar(50)
  outletName String? @db.VarChar(150)
  district String? @db.VarChar(100)

  latitude Float?
  longitude Float?

  plannedEta String? @db.VarChar(40)
  actualArrival String? @db.VarChar(40)

  status String @default("PENDING") @db.VarChar(40)
  outcome String? @db.VarChar(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([liveTripId, sequence])
  @@index([outletCode])
  @@map("live_trip_stops")
}

model LiveTripEvent {
  id Int @id @default(autoincrement())

  liveTripId Int
  liveTrip LiveTrip @relation(fields: [liveTripId], references: [id], onDelete: Cascade)

  type String @db.VarChar(60)
  message String @db.Text
  payload Json?

  createdAt DateTime @default(now())

  @@index([liveTripId, createdAt])
  @@map("live_trip_events")
}
