{
  "name": "nexora-waypoint-backend",
  "version": "1.0.0",
  "description": "Backend API for the Nexora Waypoint Delivery System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.js",
    "start": "tsx server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "data:import-outlets": "tsx src/scripts/importOrganizerOutlets.js",
    "seed:store-manager": "tsx src/scripts/seedStoreManager.js",
    "seed:admin": "tsx src/scripts/seedAdmin.js",
    "test:email": "tsx src/scripts/testEmailConnection.js",
    "setup:store-manager-data": "npm run data:import-outlets && npm run seed:store-manager",
    "test": "npm run test:store-manager-http",
    "test:store-manager-http": "tsx src/scripts/testStoreManagerHttpSecurity.js",
    "translation:warmup": "tsx src/scripts/warmTranslationModel.js"
  },
  "keywords": [
    "nexora",
    "waypoint",
    "delivery",
    "express",
    "mysql",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@prisma/adapter-mariadb": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.13",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.0.0",
    "supertest": "^7.3.0"
  }
}