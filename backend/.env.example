# ============================================================
# Nexora Waypoint Backend - Environment Template
# ============================================================
#
# Copy this file:
#
#   .env.example -> .env
#
# Then replace all CHANGE_ME values.
#
# NEVER commit the real .env file.
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

NODE_ENV=development

PORT=5000

CLIENT_URL=http://localhost:5173


# ============================================================
# MYSQL DATABASE
# ============================================================

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307

DATABASE_USER=nexora_app
DATABASE_PASSWORD=CHANGE_ME

DATABASE_NAME=nexora_waypoint

DATABASE_URL="mysql://nexora_app:CHANGE_ME@127.0.0.1:3307/nexora_waypoint"

SHADOW_DATABASE_URL="mysql://nexora_app:CHANGE_ME@127.0.0.1:3307/nexora_waypoint_shadow"


# ============================================================
# JWT AUTHENTICATION
# ============================================================

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

JWT_EXPIRES_IN=8h


# ============================================================
# PASSWORD RESET OTP
# ============================================================

PASSWORD_RESET_OTP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

PASSWORD_RESET_OTP_EXPIRY_MINUTES=10

PASSWORD_RESET_OTP_RESEND_SECONDS=60

PASSWORD_RESET_OTP_MAX_ATTEMPTS=5


# ============================================================
# SMTP EMAIL
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=your-email@gmail.com

# Use a Gmail App Password, not your normal Gmail password.
SMTP_PASSWORD=CHANGE_ME

SMTP_FROM="Waypoint Delivery Operations <your-email@gmail.com>"


# ============================================================
# PASSWORD RESET AUTHORIZATION TOKEN
# ============================================================

PASSWORD_RESET_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

PASSWORD_RESET_TOKEN_EXPIRES_IN=10m


# ============================================================
# ADMIN REGISTRATION
# ============================================================

ADMIN_REGISTRATION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET


# ============================================================
# TRANSLATION SERVICE
# ============================================================

TRANSLATION_PROVIDER=nllb-local

TRANSLATION_MODEL_ID=Xenova/nllb-200-distilled-600M

TRANSLATION_MODEL_DTYPE=q8

TRANSLATION_CACHE_ENABLED=true

TRANSLATION_MAX_BATCH_SIZE=50

TRANSLATION_MAX_TEXT_LENGTH=2000

TRANSLATION_MAX_TOTAL_CHARACTERS=20000


# ============================================================
# DEPLOYMENT / DEMO SEED SETTINGS
# ============================================================

SEED_MUST_CHANGE_PASSWORD=false

# Keep false normally.
# Set true only when intentionally resetting seeded passwords.
SEED_RESET_EXISTING_PASSWORDS=false


# ============================================================
# ADMIN SEED ACCOUNT
# ============================================================

ADMIN_SEED_USER_ID=ADMIN001
ADMIN_SEED_FULL_NAME=Nexora Administrator
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=CHANGE_ME_ADMIN_PASSWORD


# ============================================================
# STORE MANAGER SEED ACCOUNT
# ============================================================

STORE_MANAGER_SEED_USER_ID=SM001
STORE_MANAGER_SEED_FULL_NAME=Nexora Store Manager
STORE_MANAGER_SEED_EMAIL=storemanager@example.com
STORE_MANAGER_SEED_PASSWORD=CHANGE_ME_STORE_MANAGER_PASSWORD

STORE_MANAGER_SEED_OUTLET_CODE=OUT001


# ============================================================
# DISPATCHER SEED ACCOUNT
# ============================================================

DISPATCHER_SEED_USER_ID=DSP001
DISPATCHER_SEED_FULL_NAME=Nexora Dispatcher
DISPATCHER_SEED_EMAIL=dispatcher@example.com
DISPATCHER_SEED_PASSWORD=CHANGE_ME_DISPATCHER_PASSWORD

DISPATCHER_SEED_DEPOT_CODE=PELIYAGODA


# ============================================================
# LOADER SEED ACCOUNT
# ============================================================

LOADER_SEED_USER_ID=LDR001
LOADER_SEED_FULL_NAME=Nexora Loader
LOADER_SEED_EMAIL=loader@example.com
LOADER_SEED_PASSWORD=CHANGE_ME_LOADER_PASSWORD

LOADER_SEED_DEPOT_CODE=PELIYAGODA


# ============================================================
# DRIVER SEED ACCOUNT
# ============================================================

DRIVER_SEED_USER_ID=DRV001
DRIVER_SEED_FULL_NAME=Nexora Driver
DRIVER_SEED_EMAIL=driver@example.com
DRIVER_SEED_PASSWORD=CHANGE_ME_DRIVER_PASSWORD

DRIVER_SEED_DEPOT_CODE=PELIYAGODA