# ============================================================
# Nexora Waypoint Backend - Environment Template
# ============================================================
#
# Copy this file to ".env" for local development.
# Never commit the real backend/.env file.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------
# Main MySQL database
# ------------------------------------------------------------

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=nexora_waypoint

DATABASE_URL="mysql://your_database_user:your_database_password@127.0.0.1:3307/nexora_waypoint"

# ------------------------------------------------------------
# Prisma development shadow database
# ------------------------------------------------------------
#
# IMPORTANT: this must never point to the main application
# database.
# ------------------------------------------------------------

SHADOW_DATABASE_URL="mysql://your_database_user:your_database_password@127.0.0.1:3307/nexora_waypoint_shadow"

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------
# Development Store Manager seed account
# ------------------------------------------------------------

STORE_MANAGER_SEED_EMAIL=storemanager@example.com
STORE_MANAGER_SEED_PASSWORD=replace_with_a_strong_temporary_password

# ------------------------------------------------------------
# Initial Administrator bootstrap account
# ------------------------------------------------------------

ADMIN_SEED_USER_ID=ADMIN001
ADMIN_SEED_FULL_NAME=Development Administrator
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PHONE=
ADMIN_SEED_PASSWORD=replace_with_a_strong_temporary_password

# ------------------------------------------------------------
# Administrator self-registration
# ------------------------------------------------------------

ADMIN_REGISTRATION_SECRET=replace_with_a_private_admin_registration_key

# ------------------------------------------------------------
# Password reset security
# ------------------------------------------------------------
#
# Generate two different random secrets, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------

PASSWORD_RESET_OTP_SECRET=replace_with_a_long_random_secret
PASSWORD_RESET_TOKEN_SECRET=replace_with_a_different_long_random_secret
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_OTP_RESEND_SECONDS=60
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRES_IN=10m

# ------------------------------------------------------------
# Email delivery
# ------------------------------------------------------------
#
# SMTP is used in every environment; console OTP output is disabled.
#
# For Gmail/Google Workspace, SMTP_PASSWORD normally needs an
# App Password when the account permits it. Do not place your
# normal Google account password here.
# ------------------------------------------------------------

EMAIL_DELIVERY_MODE=smtp

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=replace_with_an_app_password_or_smtp_password
SMTP_FROM=your_email@example.com
