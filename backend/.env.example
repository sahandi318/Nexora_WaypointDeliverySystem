# ============================================================
# Nexora Waypoint Backend - Environment Template
# ============================================================
#
# Copy this file to ".env" for local development.
# Never commit the real backend/.env file.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NODE_ENV=development
PORT=5000

CLIENT_URL=http://localhost:5173


# ------------------------------------------------------------
# Main MySQL database
# ------------------------------------------------------------

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307

DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=nexora_waypoint

DATABASE_URL="mysql://your_database_user:your_database_password@127.0.0.1:3307/nexora_waypoint"


# ------------------------------------------------------------
# Prisma development shadow database
# ------------------------------------------------------------
#
# Used only by Prisma Migrate during development.
#
# IMPORTANT:
# This must never point to the main application database.
# ------------------------------------------------------------

SHADOW_DATABASE_URL="mysql://your_database_user:your_database_password@127.0.0.1:3307/nexora_waypoint_shadow"


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=8h


# ------------------------------------------------------------
# Development Store Manager seed account
# ------------------------------------------------------------
#
# Used by:
#
# npm run seed:store-manager
#
# This value is used only to generate the bcrypt password hash.
# Do not reuse development credentials in production.
# ------------------------------------------------------------

STORE_MANAGER_SEED_PASSWORD=replace_with_a_development_password